APP_NAME="Expense Review for Xero"
APP_ENV=local
APP_KEY=
# Local: true is fine. Production: must be false (never ship with debug pages/stack traces).
APP_DEBUG=true
# Use the real public URL, including scheme. Must match how users reach the app and Xero OAuth redirect URIs (https in production).
APP_URL=http://localhost
# APP_GITHUB_URL=https://github.com/your-org/your-fork

# When true, DatabaseSeeder creates test@example.com (factory password: password). This blocks first-user browser registration.
# SEED_TEST_USER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local: debug. Production: use info or error.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Defaults to false. Optional defense-in-depth if the session store could be exposed (e.g. shared DB backups); adds CPU cost and key-rotation considerations.
SESSION_ENCRYPT=false
# Production behind HTTPS: set true so the session cookie is only sent over TLS (keep APP_URL=https://... consistent).
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Log queue job lifecycle (queued, processing, processed, failed) with message key queue.job
# QUEUE_LOG_JOBS=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Single callback for Sign in with Xero (OIDC) and Connect Xero (accounting API). Register exactly in the Xero developer portal (scheme/host must match APP_URL).
XERO_REDIRECT_URI="${APP_URL}/xero/callback"
XERO_SCOPES="offline_access accounting.transactions accounting.contacts accounting.settings"
# When unset, defaults to false: only the first user (empty DB), invited users, or existing accounts may sign in via Xero.
# Use true only for a public product where anyone may self-provision. For private/single-tenant deployments, keep false in production.
XERO_ALLOW_OPEN_SIGNUP=false
# When true (default), successful Xero SSO will attach users as reviewers for linked orgs where GET /Users lists them with STANDARD, FINANCIALADVISER, or MANAGEDCLIENT.
XERO_SSO_AUTO_REVIEWER_ACCESS=true

XERO_SSO_SCOPES="openid profile email"
# XERO_SSO_ISSUER=https://identity.xero.com
# XERO_SSO_JWKS_URI=https://identity.xero.com/.well-known/openid-configuration/jwks
